rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /friends/{friendUid} {
        // Own list, or the friend writing/removing themselves (mutual operations)
        allow read, write: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /usernames/{slug} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Launcher sessions — public read (launcher reads before signing in)
    match /launcher_sessions/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ayudar a un amigo (launcher) — señalización WebRTC entre dos launchers.
    // El documento solo sirve para que se encuentren: el anfitrión lo crea con
    // su oferta, el ayudante (que conoce el código) responde UNA vez, y el
    // anfitrión lo borra al conectar, al cancelar o al cerrar el launcher.
    // No se puede listar la colección: si no, se podrían enumerar los códigos.
    match /assist/{code} {
      allow get:  if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasOnly(['hostUid','hostName','instanceName','minecraft','loader','offer','status','createdAt','expiresAt','expireAt'])
        && request.resource.data.offer is string
        && request.resource.data.offer.size() < 50000;

      allow update: if request.auth != null && (
        // El anfitrión manda sobre su propio documento.
        resource.data.hostUid == request.auth.uid
        // El ayudante solo entra una vez: waiting -> requested, y nada más.
        || (
          resource.data.status == 'waiting'
          && request.resource.data.status == 'requested'
          && request.resource.data.helperUid == request.auth.uid
          && request.auth.uid != resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','helperUid','helperName','status'])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() < 50000
        )
      );

      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /friendRequests/{reqId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      // Split read rules so Firestore can verify each from query constraints
      allow read: if request.auth != null && resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null && resource.data.toUid   == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.toUid   == request.auth.uid;
    }

    // Notificaciones: cada quien lee y borra las suyas; cualquiera autenticado
    // puede crear una a nombre propio, y el destinatario solo puede marcarla
    // como leída (no reescribir su contenido).
    match /notifications/{nid} {
      allow read:   if request.auth != null && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.read == false;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if request.auth != null && resource.data.toUid == request.auth.uid;
    }

    // Conversations (mensajes page)
    match /conversations/{cid} {
      function esAdminDelGrupo(datos) {
        return datos.startedBy == request.auth.uid
            || (datos.admins is list && request.auth.uid in datos.admins);
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;

      // Solo @fport1 puede crear grupos anónimos.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantUids
                    && (request.resource.data.get('anonymous', false) == false
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameSlug == 'fport1');

      // Los campos delicados del grupo (incluido 'anonymous', que no se puede
      // desactivar despues) solo los toca un admin del grupo.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantUids
                    && (
                      !request.resource.data.diff(resource.data).changedKeys()
                        .hasAny(['admins','startedBy','isGroup','anonymous','groupName','groupPhotoURL','participantUids'])
                      || esAdminDelGrupo(resource.data)
                    );

      allow delete: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantUids;
      }
    }

    // Chat invite links (personal link per user)
    match /chatLinks/{token} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Conversation share links (?v=token)
    match /convLinks/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
    }

    // ── Avengers: Doomsday ─────────────────────────────────────
    function isDoomsdayAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameSlug == 'fport1';
    }
    function hasDoomsdayAccess() {
      return request.auth != null
        && (isDoomsdayAdmin()
            || exists(/databases/$(database)/documents/doomsday_access/$(request.auth.uid)));
    }

    // Accesos concedidos por el admin. Cada quien puede consultar el suyo
    // (el nav lo necesita); listar y modificar es solo del admin.
    match /doomsday_access/{uid} {
      allow get:   if request.auth != null;
      allow list:  if isDoomsdayAdmin();
      allow write: if isDoomsdayAdmin();
    }

    // Contador público de asistentes. Existe para poder enseñar CUÁNTOS van sin
    // dejar leer QUIÉNES: la colección de arriba no se puede listar, así que el
    // número no se puede sacar de ahí. Cada quien lo ajusta en ±1 al entrar o
    // salir de la lista; el admin puede corregirlo si se descuadra.
    match /doomsday_meta/{docId} {
      allow read:  if hasDoomsdayAccess();
      allow write: if isDoomsdayAdmin();
      allow write: if hasDoomsdayAccess()
                   && docId == 'stats'
                   && request.resource.data.keys().hasOnly(['count'])
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0
                   && (!exists(/databases/$(database)/documents/doomsday_meta/stats)
                       || (request.resource.data.count - resource.data.count) in [1, -1]);
    }

    // Lista de asistentes. SOLO el admin puede ver quién está: los demás
    // únicamente leen su propio registro y no pueden listar la coleccion.
    // El usuario entra y se sale solo, PERO no puede salirse si ya compró
    // boleta, ni marcarse la boleta a sí mismo (eso es del admin).
    match /doomsday_rsvps/{uid} {
      allow get:    if isDoomsdayAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list:   if isDoomsdayAdmin();
      allow create: if hasDoomsdayAccess() && request.auth.uid == uid
                    && request.resource.data.bought == false
                    && request.resource.data.tickets == 0;
      allow delete: if hasDoomsdayAccess() && request.auth.uid == uid
                    && resource.data.bought != true;
      allow write:  if isDoomsdayAdmin();
    }

    match /chats/{chatId} {
      // get: allow reading non-existent docs (resource == null) so openChat can check existence
      allow get:    if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list:   if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.members;
      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // Catálogo de proyectos de Fport1 (modpacks, descargas…).
    // Lo publica y administra solo @fport1; el resto del mundo únicamente ve lo
    // que está publicado. La única escritura ajena permitida es sumar 1 al
    // contador de descargas, y nada más de ese documento.
    match /fport1_projects/{pid} {
      function esFport1() {
        return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameSlug == 'fport1';
      }
      function soloSumaDescarga() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
          && request.resource.data.downloads == resource.data.downloads + 1;
      }

      allow read: if resource.data.published == true || esFport1();
      allow create, delete: if esFport1();
      allow update: if esFport1() || soloSumaDescarga();

      match /versions/{vid} {
        allow read: if get(/databases/$(database)/documents/fport1_projects/$(pid)).data.published == true
                    || esFport1();
        allow create, delete: if esFport1();
        allow update: if esFport1() || soloSumaDescarga();
      }
    }

    // ── Estadísticas anónimas y aprendizaje de la IA del launcher ────────────
    // Las escribe el launcher SIN iniciar sesión (muchos no tienen cuenta de
    // fport1social), así que cada regla limita qué campos existen, su tamaño y
    // cuánto puede subir cada contador en una escritura. Nadie puede borrar ni
    // bajar números. Las estadísticas solo las lee @fport1; las lecciones y las
    // huellas de crash son públicas porque las usa la IA de cualquier launcher.
    function esFport1Launcher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameSlug == 'fport1';
    }
    // Valor anterior de un contador (0 si el documento o el campo no existían)
    function antes(campo) {
      return resource == null ? 0 : resource.data.get(campo, 0);
    }
    // El contador no existe todavía, o es entero y sube entre 0 y max
    function subeHasta(campo, max) {
      return !(campo in request.resource.data)
        || (request.resource.data[campo] is int
            && request.resource.data[campo] >= antes(campo)
            && request.resource.data[campo] <= antes(campo) + max);
    }
    function textoCorto(campo, max) {
      return !(campo in request.resource.data)
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= max);
    }

    // Número dentro de un rango. Recibe el mapa YA resuelto, no su nombre: cada
    // request.resource.data[mapa][campo] se reevalúa entero, y Firestore corta a
    // las 1000 evaluaciones por petición. Con la ruta completa se agotaba el
    // presupuesto y rechazaba documentos válidos.
    function numeroEntre(m, campo, min, max) {
      return !(campo in m) || (m[campo] is number && m[campo] >= min && m[campo] <= max);
    }
    function esNumero(m, campo) {
      return !(campo in m) || m[campo] is number;
    }

    // Resumen de rendimiento de un tramo de juego (antes o después de un cambio).
    // Puede faltar entero, porque hay veredictos como 'sin datos de antes'. Si
    // viene, todos sus campos han de ser números: sin eso, uno sin comprobar
    // aceptaría una cadena enorme en una colección que escribe cualquiera.
    function resumenValido(campo) {
      return !(campo in request.resource.data)
        || (request.resource.data[campo] is map && resumenNumeros(request.resource.data[campo]));
    }
    function resumenNumeros(r) {
      return r.keys().hasOnly(['minutes', 'counted', 'fpsAvg', 'fpsMin', 'msptAvg', 'msptP95',
               'errorsPerMin', 'warningsPerMin', 'lagPerMin', 'worldLoadMs'])
        && numeroEntre(r, 'minutes', 0, 1440) && numeroEntre(r, 'counted', 0, 1440)
        && esNumero(r, 'fpsAvg') && esNumero(r, 'fpsMin')
        && esNumero(r, 'msptAvg') && esNumero(r, 'msptP95')
        && esNumero(r, 'errorsPerMin') && esNumero(r, 'warningsPerMin')
        && esNumero(r, 'lagPerMin') && esNumero(r, 'worldLoadMs');
    }

    // Medición en vivo del mod, dentro de play_sessions.
    function liveValido(l) {
      return l.keys().hasOnly(['fpsAvg', 'fpsP5', 'msptAvg', 'msptP95', 'lagPerMin',
               'worldLoadMs', 'dimLoadMs', 'memMaxMb', 'topEntities', 'samples'])
        && numeroEntre(l, 'fpsAvg', 0, 2000) && numeroEntre(l, 'fpsP5', 0, 2000)
        && numeroEntre(l, 'msptAvg', 0, 60000) && numeroEntre(l, 'msptP95', 0, 60000)
        && esNumero(l, 'lagPerMin') && esNumero(l, 'samples')
        && esNumero(l, 'worldLoadMs') && esNumero(l, 'dimLoadMs') && esNumero(l, 'memMaxMb')
        && (!('topEntities' in l) || (l.topEntities is map && l.topEntities.size() <= 10));
    }

    // Una ficha por instalación (id aleatorio, no sale de ningún dato personal)
    match /launcher_installs/{id} {
      allow read: if esFport1Launcher();
      allow create, update: if id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly(['firstSeen', 'firstDay', 'lastSeen', 'v', 'os', 'arch', 'osv',
             'lang', 'sysLang', 'instances', 'loaders', 'mc', 'social', 'premium', 'launches', 'days', 'sessions',
             'playMinutes', 'crashes', 'aiActions', 'aiLessonsShared', 'modInstalls'])
        // firstSeen se fija una vez y ya no cambia
        && (resource == null || !('firstSeen' in resource.data)
            || request.resource.data.firstSeen == resource.data.firstSeen)
        && request.resource.data.lastSeen == request.time
        && textoCorto('v', 20) && textoCorto('os', 12) && textoCorto('arch', 12) && textoCorto('osv', 12)
        && textoCorto('lang', 5) && textoCorto('sysLang', 5) && textoCorto('firstDay', 10)
        && (!('loaders' in request.resource.data) || (request.resource.data.loaders is map && request.resource.data.loaders.size() <= 10))
        && (!('mc' in request.resource.data) || (request.resource.data.mc is map && request.resource.data.mc.size() <= 8))
        && (!('instances' in request.resource.data) || (request.resource.data.instances is int && request.resource.data.instances <= 10000))
        && (!('social' in request.resource.data) || request.resource.data.social is bool)
        && (!('premium' in request.resource.data) || request.resource.data.premium is bool)
        && subeHasta('launches', 200) && subeHasta('days', 1) && subeHasta('sessions', 200)
        && subeHasta('playMinutes', 20000) && subeHasta('crashes', 200) && subeHasta('aiActions', 2000)
        && subeHasta('aiLessonsShared', 200) && subeHasta('modInstalls', 2000);
      allow delete: if false;
    }

    // Totales de cada día (AAAA-MM-DD)
    match /launcher_days/{day} {
      allow read: if esFport1Launcher();
      allow create, update: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['active', 'new', 'socialActive', 'launches', 'sessions',
             'playMinutes', 'crashes', 'aiActions', 'aiLessonsShared', 'modInstalls'])
        && subeHasta('active', 1) && subeHasta('new', 1) && subeHasta('socialActive', 1)
        && subeHasta('launches', 200) && subeHasta('sessions', 200) && subeHasta('playMinutes', 20000)
        && subeHasta('crashes', 200) && subeHasta('aiActions', 2000) && subeHasta('aiLessonsShared', 200)
        && subeHasta('modInstalls', 2000);
      allow delete: if false;
    }

    // Lecciones que aprende la IA al arreglar o construir algo (texto ya saneado por el launcher):
    // crash, config, compatibilidad, construccion, mundo, rendimiento o mecanica.
    // Se crean con worked = failed = 0 y después solo se puede sumar 1 a uno de los dos.
    match /ai_lessons/{id} {
      allow read: if true;
      allow create: if id.matches('^[A-Za-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['kind', 'title', 'symptom', 'cause', 'fix', 'mods', 'mc', 'loader', 'sig', 'v', 'worked', 'failed', 'created'])
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['crash', 'config', 'compatibilidad', 'construccion', 'mundo', 'rendimiento', 'mecanica'])
        && request.resource.data.keys().hasAll(['title', 'symptom', 'cause', 'fix', 'mc', 'loader', 'worked', 'failed'])
        && textoCorto('title', 130) && textoCorto('symptom', 610) && textoCorto('cause', 610) && textoCorto('fix', 610)
        && textoCorto('mc', 24) && textoCorto('loader', 16) && textoCorto('sig', 24) && textoCorto('v', 20)
        && (!('mods' in request.resource.data) || (request.resource.data.mods is list && request.resource.data.mods.size() <= 10))
        && request.resource.data.worked == 0 && request.resource.data.failed == 0
        && request.resource.data.created == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['worked', 'failed'])
        && subeHasta('worked', 1) && subeHasta('failed', 1);
      allow delete: if esFport1Launcher();
    }

    // Huellas de crash: tipo de error y mods implicados, sin datos del equipo
    match /crash_signatures/{hash} {
      allow read: if true;
      allow create, update: if hash.matches('^[0-9a-f]{24}$')
        && request.resource.data.keys().hasOnly(['sig', 'mods', 'mc', 'loader', 'count', 'lastSeen'])
        && textoCorto('sig', 520) && textoCorto('mc', 24) && textoCorto('loader', 16)
        && (!('mods' in request.resource.data) || (request.resource.data.mods is list && request.resource.data.mods.size() <= 10))
        && request.resource.data.lastSeen == request.time
        && subeHasta('count', 1);
      allow delete: if esFport1Launcher();
    }

    // Resumen anónimo de cada partida: mods, cómo es el mundo (sin nombre, semilla
    // ni coordenadas), qué pasó y el rendimiento. La IA lo usa para saber cómo se
    // comporta el juego con cada mod. Solo se crea; nadie lo cambia después.
    match /play_sessions/{id} {
      allow read: if true;
      allow create: if id.matches('^[A-Za-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['mc', 'loader', 'v', 'mods', 'modCount', 'minutes', 'crashed', 'sig',
             'loadSeconds', 'lagWarnings', 'errors', 'warnings', 'noisy', 'world', 'live', 'at'])
        && textoCorto('mc', 24) && textoCorto('loader', 16) && textoCorto('v', 20) && textoCorto('sig', 24)
        && request.resource.data.mods is list && request.resource.data.mods.size() <= 150
        && request.resource.data.modCount is int && request.resource.data.modCount <= 1000
        && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1440
        && request.resource.data.crashed is bool
        && request.resource.data.loadSeconds is int && request.resource.data.lagWarnings is int
        && request.resource.data.errors is int && request.resource.data.warnings is int
        && request.resource.data.noisy is map && request.resource.data.noisy.size() <= 12
        && (!('world' in request.resource.data)
            || (request.resource.data.world is map
                && request.resource.data.world.keys().hasOnly(['mode', 'difficulty', 'hardcore', 'cheats', 'dims', 'gen',
                     'datapacks', 'rules', 'minutes', 'killed', 'killedBy', 'deaths', 'mined'])))
        // Medición en vivo del mod fport1-social. Opcional: las partidas que ya
        // sube el launcher no la traen y tienen que seguir entrando igual.
        && (!('live' in request.resource.data)
            || (request.resource.data.live is map && liveValido(request.resource.data.live)))
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if esFport1Launcher();
    }

    // Resultado MEDIDO de un cambio que hizo la IA: cómo iba el juego antes y
    // después, con números del mod, no con lo que la IA cree que pasó.
    // Solo se crea; nadie lo modifica luego, así que el histórico no se puede
    // reescribir. `label` no se sube: es texto libre que escribe la IA.
    match /live_outcomes/{id} {
      allow read: if true;
      allow create: if id.matches('^[A-Za-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['kind', 'target', 'mc', 'loader', 'v', 'modVersion', 'mods',
             'before', 'after', 'ranAfter', 'verdict', 'lessonId', 'at'])
        && request.resource.data.kind in ['mod', 'config', 'datapack', 'resourcepack', 'shader', 'world', 'other']
        && request.resource.data.verdict in ['mejor', 'peor', 'igual', 'sin datos', 'sin datos de antes']
        // target es obligatorio y con forma de identificador: ni espacios ni
        // mayúsculas, así no cabe texto libre disfrazado de nombre de mod.
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 64
        && request.resource.data.target.matches('^[a-z0-9_.:/-]*$')
        && textoCorto('mc', 24) && textoCorto('loader', 16) && textoCorto('v', 20) && textoCorto('modVersion', 24)
        && textoCorto('lessonId', 40)
        && (!('mods' in request.resource.data)
            || (request.resource.data.mods is list && request.resource.data.mods.size() <= 150))
        && resumenValido('before') && resumenValido('after')
        && request.resource.data.ranAfter is bool
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if esFport1Launcher();
    }
  }
}