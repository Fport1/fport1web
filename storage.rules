rules_version = '2';

// Reglas de Firebase Storage para Fport1.
//
// Los adjuntos del chat tienen la LECTURA CERRADA: para ver uno hay que pedir
// un enlace temporal a /api/chat-media, que comprueba que quien lo pide
// participa en esa conversación. Se hace así, y no con reglas entre servicios,
// porque habría que consultar Firestore en CADA lectura de archivo: sale caro
// y lento cuando un chat carga muchas imágenes de golpe.
//
// Donde sí se usa firestore.get() es en el catálogo: es una escritura puntual
// del administrador, no un camino caliente.
service firebase.storage {
  match /b/{bucket}/o {

    // Tipos permitidos en el chat: medios que se muestran incrustados, más
    // documentos y comprimidos (que nunca se muestran, solo se descargan a
    // través de /api/download, que fuerza "guardar como").
    // Lo que se bloquea aquí son los EJECUTABLES. El navegador ya valida además
    // la firma real del archivo (src/lib/chatFileGuard.js); esto es la segunda
    // capa, por si alguien se salta el cliente.
    function tipoDeChatPermitido() {
      return request.resource.contentType.matches(
        'image/(jpeg|png|webp|gif|svg\\+xml)' +
        '|video/(mp4|webm|quicktime)' +
        '|audio/(mpeg|mp4|aac|ogg|wav|webm)' +
        '|application/(pdf|zip|x-zip-compressed|x-rar-compressed|vnd\\.rar|x-7z-compressed|x-tar|gzip|json|xml|rtf)' +
        '|application/msword|application/vnd\\.ms-.*|application/vnd\\.openxmlformats-officedocument\\..*|application/vnd\\.oasis\\.opendocument\\..*' +
        '|text/(plain|csv|markdown|html|xml)'
      );
    }

    // Fotos de grupo: las ve todo el que está en el grupo y aparecen en la
    // lista de chats, así que aquí sí vale una URL estable de solo lectura.
    match /groupPhotos/{ownerUid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Adjuntos normales del chat. Lectura cerrada a propósito (ver cabecera).
    match /uploads/{ownerUid}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 25 * 1024 * 1024
                   && tipoDeChatPermitido();
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // "Ver/escuchar una vez": cualquiera autenticado puede destruirlos, que es
    // justo su propósito. La lectura también va por enlace temporal.
    match /viewonce/{ownerUid}/{allPaths=**} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.auth.uid == ownerUid
                    && request.resource.size < 25 * 1024 * 1024
                    && tipoDeChatPermitido();
      allow delete: if request.auth != null;
    }

    // Conversaciones: ruta legada, solo lectura para adjuntos antiguos que
    // todavía guardan una URL permanente.
    match /conversations/{cid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if false;
    }

    // Fotos de perfil y avatares.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Archivos del catálogo de Fport1 (instaladores, imágenes de los proyectos).
    // Lectura pública porque son descargas abiertas; escribir y borrar, solo
    // @fport1.
    //
    // El uid va fijo, no por comodidad: la alternativa natural sería mirar el
    // perfil en Firestore desde aquí (firestore.get sobre users/{uid}). Esa
    // versión compila, pero se probó en ejecución y el bucket la rechaza con
    // storage/unauthorized incluso para @fport1, así que las reglas entre
    // servicios no están disponibles en este proyecto.
    //
    // Si cambia la cuenta administradora hay que actualizar este uid.
    match /fport1/projects/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null
        && request.auth.uid == 'KSLnFnpX1ibA1RgJ1aifB2VWOyi1'
        && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }

    // Puente temporal para publicar archivos grandes en GitHub: una funcion de
    // Vercel no admite cuerpos de mas de 4,5 MB, asi que el navegador de 'fport1
    // sube aqui y el servidor lo copia a la release y borra el temporal. Nadie
    // lo lee desde el cliente; el servidor usa el Admin SDK.
    match /fport1/tmp/{uid}/{allPaths=**} {
      allow read: if false;
      allow write, delete: if request.auth != null
        && request.auth.uid == 'KSLnFnpX1ibA1RgJ1aifB2VWOyi1'
        && uid == request.auth.uid
        && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }

    // Series de rendimiento del mod fport1-social (un json.gz por partida).
    // CERRADO a cal y canto para los clientes: se sube solo con las URLs
    // firmadas que emite /api/ai-data-upload, y esas no pasan por estas reglas
    // porque van con la cuenta de servicio. La lectura es de servidor, nunca
    // pública: aquí hay series largas de telemetría, no descargas del catálogo.
    match /ai-data/{allPaths=**} {
      allow read, write: if false;
    }

    // Todo lo demás: bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
